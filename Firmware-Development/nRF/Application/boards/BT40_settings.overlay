//  /dts-v1/;
//  #include <nordic/nrf5340_cpuapp_qkaa.dtsi>
//  #include "nrf5340_cpuapp_common.dtsi"

/ {
	model = "Nordic NRF5340 DK NRF5340 Application";
    compatible = "nordic,nrf5340-dk-nrf5340-cpuapp";
    
	chosen {
         zephyr,sram = &sram0_image;
         zephyr,flash = &flash0;
         zephyr,code-partition = &slot0_partition;
         zephyr,sram-secure-partition = &sram0_s;
         zephyr,sram-non-secure-partition = &sram0_ns;
	};

	aliases {
		errorled = &led0;
		powerled = &led1;
		debugled = &led2;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			status = "disabled";
		};
		button1: button_1 {
			status = "disabled";
		};
		button2: button_2 {
			status = "disabled";
		};
		button3: button_3 {
			status = "disabled";
		};
	};
		
	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
			label = "red_LED";
		};
		led1: led_1 {
			gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
			label = "green_LED";
		};
		led2: led_2 {
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
			label = "blue_LED";
		};
	};
};

&led3 {
	status = "disabled";
	label = "not_used";
};
	
&uart0 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};
	
&uart2 {
    status = "okay";
    current-speed = <115200>;
	pinctrl-0 = <&uart2_default>;
	pinctrl-1 = <&uart2_sleep>;
	pinctrl-names = "default", "sleep";
    // tx-pin = <47>;
    // rx-pin = <45>;
    // rts-pin = <0xFFFFFFFF>;
    // cts-pin = <0xFFFFFFFF>;
};

&uart3 {
	status = "okay";
    current-speed = <115200>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
    // tx-pin = <31>;
    // rx-pin = <17>;
    // rts-pin = <0xFFFFFFFF>;
    // cts-pin = <0xFFFFFFFF>;
};

&spi0 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>, <&gpio0 25 GPIO_ACTIVE_LOW>;
	// sck-pin = <23>;
	// miso-pin = <20>; //DOUT
	// mosi-pin = <29>; //DIN
	
	ads131m08: ads131m08@0 {
		status = "okay";
		reg = <0>;
		label = "ADS131M08_0";
	};

	ads131m08_0: ads131m08@1 {
		status = "okay";
		reg = <1>;
		label = "ADS131M08_1";
	};
};

&spi4 {
	status = "disabled";
};

&i2c1 {
   status = "okay";
   pinctrl-0 = <&i2c1_default>;
   pinctrl-1 = <&i2c1_sleep>;
   // sda-pin = <34>;
   // scl-pin = <35>;
   
   max30102: max30102@57 {
	   compatible = "maxim,max30102";
       label = "MAX30102";
       reg = <0x57>;
       mode = <2>;
	//    interrupts = ;
       status = "okay";
	};
	
	bme280: bme280@76 {
	   /* 0x76 - SDO <-> GND */
	   /* 0x77 - SDO <-> VCC */
	   compatible = "bosch,bme280";
	   reg = <0x76>;
	   // label = "ENVIRONMENTAL_SENSOR";		// deprecated property
	};
};

i2s_rxtx: &i2s0 {
    status = "okay";
	pinctrl-0 = <&i2s_default>;
    // sck-pin =   <43>; 
    // lrck-pin =  <8>; 
    // sdout-pin = <44>;
    // sdin-pin =  <46>; 
    clock-source = "ACLK";
};

dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm_default>;
	// clk-pin = <40>; 
	// din-pin = <13>; 
	clock-source = "ACLK";
};
	
&zephyr_udc0 {
    cdc_acm_uart2 {
        compatible = "zephyr,cdc-acm-uart";
        // label = "CDC_ACM_0";			// Deprecated
    };
};

&clock {
    hfclkaudio-frequency = <11289600>;
};

&usbreg {
     status = "disabled";
};
	
&qspi {
	status = "disabled";
};
 
&ieee802154 {
	status = "disabled";
};
 
// &mbox {
// 	status = "disabled";
// };
 
&mutex {
	status = "disabled";
};

&nfct {
	status = "disabled";
};

&oscillators {
	status = "disabled";
};

&pwm0 {
	status = "disabled";
};

&ctrlap {
	status = "disabled";
};

&reset {
	status = "disabled";
};

&dcnf {
	status = "disabled";
};


&rtc1 {
	status = "disabled";
};

// gpio0: gpio@842500 {
// 	compatible = "nordic,nrf-gpio";
// 	gpio-controller;
// 	reg = <0x842500 0x300>;
// 	#gpio-cells = <2>;
// 	label = "GPIO_0";
// 	status = "disabled";
// 	port = <0>;
// };

